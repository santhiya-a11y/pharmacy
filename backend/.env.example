NODE_ENV=development
DB_MODE=online
PORT=4000
NEDB_DATA_DIR=./data/nedb
MONGODB_URI=mongodb://127.0.0.1:27017/pill_smart
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_MB=5
STRICT_ENV=false
SEED_DEFAULT_PASSWORD=ChangeThisSeedPassword123!
